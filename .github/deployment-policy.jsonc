{
  "schemaVersion": 1,
  // One Worker, no wrangler `env` block. Under `single` the candidate and the
  // release are the same Worker and promotion splits by traffic: a merge to
  // main uploads a version at 0%, then the release deploy makes it serve.
  // Targets name no wranglerEnv because there is no wrangler environment to
  // name, so the deploy omits `--env`.
  "topology": "single",
  // Merging to main has always deployed production. Automatic promotion keeps
  // that: the main flow deploys the release target and publishes the release
  // in the same run.
  "promotionMode": "automatic",
  "packageManager": "pnpm",
  "workingDirectory": ".",
  "versionFile": "package.json",
  // No workerSecrets: RECLAIM_APP_SECRET is set on the Worker directly and a
  // deploy leaves Worker secrets alone. Plain vars come from wrangler.jsonc;
  // the deploy replaces any var edited in the dashboard with the config value.
  "targets": {
    "candidate": {
      "githubEnvironment": "production",
      "url": "https://theredactedfile.com",
    },
    "release": {
      "githubEnvironment": "production",
      "url": "https://theredactedfile.com",
    },
  },
}
